worker_processes 2;
error_log /dev/stderr warn;
pid /run/nginx-shim.pid;
events { worker_connections 1024; }

http {
    access_log off;
    sendfile on;
    tcp_nopush on;
    client_max_body_size 0;
    proxy_http_version 1.1;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_connect_timeout 10s;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    upstream snappier { server 127.0.0.1:__INTERNAL_PORT__; keepalive 32; }

    server {
        listen __PORT__ default_server;
        listen [::]:__PORT__ default_server;

        # Xtream account/server info: rewrite the advertised zone to the
        # provider's zone so the app formats catch-up starts in it.
        location = /player_api.php {
            proxy_pass http://snappier;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            sub_filter_types application/json text/plain;
            sub_filter_once off;
            sub_filter '"timezone":"__TZ__"' '"timezone":"__PROVIDER_TZ__"';
            sub_filter '"timezone": "__TZ__"' '"timezone": "__PROVIDER_TZ__"';
        }

        # Everything else untouched, streamed, no buffering.
        location / {
            proxy_pass http://snappier;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
        }
    }
}
